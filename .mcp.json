{
  "inputs": [
    {
      "id": "api_token",
      "type": "promptString",
      "description": "Enter your Hostinger API token (required)"
    }
  ],
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=bstohwxzufebufbybxtd",
      "headers": {
        "Authorization": "Bearer ${SUPABASE_MCP_KEY}"
      }
    },
    "n8n": {
      "type": "http",
      "url": "https://n8n.srv1726663.hstgr.cloud/mcp-server/http",
      "headers": {
        "Authorization": "Bearer ${N8N_MCP_KEY}"
      }
    },
    "hostinger-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "hostinger-api-mcp@latest"
      ],
      "env": {
        "API_TOKEN": "${input:api_token}"
      }
    }
  }
}