    {
      "id": "wf10-n07",
      "name": "Build Notification",
      "type": "n8n-nodes-base.code",
      "position": [1400, 96],
      "typeVersion": 2,
      "parameters": {
        "jsCode": "var lang = $('Get Cleaner Profile').item.json.language_preference || 'en';\nvar zoneName = $('Zone Assigned Webhook').item.json.body.record.zone_name;\nvar facilityName = $('Get Facility').item.json.name;\nvar scheduledDate = $('Get Job').item.json.scheduled_date;\nvar cleanerId = $('Zone Assigned Webhook').item.json.body.record.cleaner_id;\n\nvar titles = {\n  en: 'New Zone Assigned',\n  es: 'Nueva zona asignada',\n  pt: 'Nova zona atribuída'\n};\nvar messages = {\n  en: 'You have been assigned ' + zoneName + ' at ' + facilityName + ' on ' + scheduledDate + '.',\n  es: 'Se te ha asignado ' + zoneName + ' en ' + facilityName + ' el ' + scheduledDate + '.',\n  pt: 'Você foi atribuído(a) a ' + zoneName + ' em ' + facilityName + ' no dia ' + scheduledDate + '.'\n};\n\nvar title = titles[lang] || titles.en;\nvar message = messages[lang] || messages.en;\n\nreturn [{ json: { title: title, message: message, user_id: cleanerId } }];"
      }
    },
    {
      "id": "wf10-n05",
      "name": "Insert Cleaner Notification",
      "type": "n8n-nodes-base.supabase",
      "position": [1640, 96],
      "typeVersion": 1,
      "parameters": {
        "tableId": "notifications",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "user_id",  "fieldValue": "={{ $json.user_id }}" },
            { "fieldId": "title",    "fieldValue": "={{ $json.title }}" },
            { "fieldId": "message",  "fieldValue": "={{ $json.message }}" },
            { "fieldId": "is_read",  "fieldValue": "=false" }
          ]
        }
      },
      "credentials": {
        "supabaseApi": { "id": "qqH4brGQ87PpjkK5", "name": "Supabase account" }
      }
    }
  ],
  "connections": {
