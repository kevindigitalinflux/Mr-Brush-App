    {
      "id": "wf10-n02",
      "name": "Has Cleaner?",
      "type": "n8n-nodes-base.if",
      "position": [440, 192],
      "typeVersion": 2,
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "typeValidation": "loose",
            "leftValue": "",
            "caseSensitive": false
          },
          "conditions": [
            {
              "operator": {
                "operation": "notEmpty",
                "singleValue": true,
                "type": "string"
              },
              "rightValue": "",
              "id": "hc01",
              "leftValue": "={{ $json.body.record.cleaner_id }}"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "wf10-n03",
      "name": "Get Job",
      "type": "n8n-nodes-base.supabase",
      "position": [680, 96],
      "typeVersion": 1,
      "parameters": {
        "tableId": "jobs",
        "operation": "getAll",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Zone Assigned Webhook').item.json.body.record.job_id }}"
