    {
      "id": "wf11-n06",
      "name": "Build Notification",
      "type": "n8n-nodes-base.code",
      "position": [1640, 192],
      "typeVersion": 2,
      "parameters": {
        "jsCode": "var lang = $('Get Cleaner Profile').item.json.language_preference || 'en';\nvar status = $('Feedback Received').item.json.body.record.status;\nvar comment = $('Feedback Received').item.json.body.record.comment;\nvar zoneName = $('Get Zone').item.json.zone_name;\nvar facilityName = $('Get Facility').item.json.name;\nvar cleanerId = $('Get Cleaning Log').item.json.cleaner_id;\n\nvar notePrefix = { en: ' Note: ', es: ' Nota: ', pt: ' Nota: ' };\n\nvar title, message;\nif (status === 'approved') {\n  var approvedTitles = { en: 'Zone Approved', es: 'Zona aprobada', pt: 'Zona aprovada' };\n  var approvedMsgs = {\n    en: 'Your work on ' + zoneName + ' at ' + facilityName + ' has been approved.',\n    es: 'Tu trabajo en ' + zoneName + ' en ' + facilityName + ' ha sido aprobado.',\n    pt: 'Seu trabalho em ' + zoneName + ' em ' + facilityName + ' foi aprovado.'\n  };\n  title = approvedTitles[lang] || approvedTitles.en;\n  message = approvedMsgs[lang] || approvedMsgs.en;\n} else if (status === 'not_accepted') {\n  var recleanTitles = { en: 'Reclean Required', es: 'Relimpieza requerida', pt: 'Relimpeza necessária' };\n  var recleanMsgs = {\n    en: 'A reclean has been requested for ' + zoneName + ' at ' + facilityName + '.',\n    es: 'Se ha solicitado una relimpieza para ' + zoneName + ' en ' + facilityName + '.',\n    pt: 'Uma relimpeza foi solicitada para ' + zoneName + ' em ' + facilityName + '.'\n  };\n  title = recleanTitles[lang] || recleanTitles.en;\n  message = (recleanMsgs[lang] || recleanMsgs.en) + (comment ? (notePrefix[lang] || ' Note: ') + comment : '');\n} else {\n  var feedbackTitles = { en: 'Supervisor Feedback', es: 'Comentario del supervisor', pt: 'Comentário do supervisor' };\n  var feedbackMsgs = {\n    en: 'Your supervisor left feedback on ' + zoneName + ' at ' + facilityName + '.',\n    es: 'Tu supervisor dejó comentarios sobre ' + zoneName + ' en ' + facilityName + '.',\n    pt: 'Seu supervisor deixou comentários sobre ' + zoneName + ' em ' + facilityName + '.'\n  };\n  title = feedbackTitles[lang] || feedbackTitles.en;\n  message = (feedbackMsgs[lang] || feedbackMsgs.en) + (comment ? (notePrefix[lang] || ' Note: ') + comment : '');\n}\n\nreturn [{ json: { title: title, message: message, user_id: cleanerId } }];"
      }
    },
